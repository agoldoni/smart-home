# Contiene le chiavi locali delle prese
dispositivi.yaml

# Scaricate dal cloud: apiSecret del progetto Tuya, chiavi locali di tutti i
# dispositivi dell'account, MAC, seriali e coordinate di casa.
chiavi/

# Credenziali del broker
.env

# Password del broker e chiavi WireGuard: generati, mai versionati
mosquitto/config/passwd
wireguard/

# Bytecode di Python, generato girando le prove
__pycache__/

# L'archivio dei consumi e l'ora in corso: sono dati, non codice. Come per
# mosquitto, la cartella resta versionata perche' il bind mount la vuole gia'
# li' e dell'utente giusto.
stato/*
!stato/.gitkeep

# Persistenza del broker: si riscrive da sola a ogni avvio, nei diff e' solo
# rumore. La cartella pero' resta versionata: il bind mount di compose la vuole
# gia' li' e dell'utente giusto, perche' creata da Docker sarebbe di root e
# mosquitto, che gira come uid 1000, non ci scriverebbe.
mosquitto/data/*
!mosquitto/data/.gitkeep
