# Credenziali del broker. Le stesse vanno messe nell'app Android.
MQTT_USER=casa
MQTT_PASS=cambiami

# Il configuratore web. Solo rete di casa e tunnel: in chiaro come il 1883.
CONFIGURATORE_PORT=8080

# WireGuard (serve solo con  docker compose --profile vpn up -d)
WG_SERVERURL=agoldoni.duckdns.org
WG_PORT=51820
WG_PEERS=telefono

# DEBUG per vedere anche i payload grezzi delle prese
LIVELLO_LOG=INFO
