<?xml version="1.0" encoding="utf-8"?>
<!-- I dati dell'app non escono dal telefono. Contengono la password del broker,
     e allowBackup="false" da solo copre il backup su cloud ma non il
     trasferimento diretto verso un telefono nuovo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
